generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  avatar        String?
  createdAt     DateTime       @default(now())
  googleId      String         @unique
  role          Role           @default(USER)
  Attendance    Attendance[]
  bookings      Booking[]
  library       Library[]
  reviews       Review[]
  trialBookings TrialBooking[]
  payments  Payment[] 
}

model Library {
  id            String         @id @default(cuid())
  name          String
  location      String
  ownerId       String
  createdAt     DateTime       @default(now())
  basePrice     Float
  contactNumber String
  facilities    String[]
  images        String[]
  rating        Float          @default(0)
  totalSeats    Int
  address       String         @default(" ")
  trialDuration Int            @default(0)
  Attendance    Attendance[]
  bookings      Booking[]
  owner         User           @relation(fields: [ownerId], references: [id])
  reviews       Review[]
  slotTypes     SlotType[]
  trialBookings TrialBooking[]
  token       String?          @default(cuid())
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  description String
  userId      String
  libraryId   String
  createdAt   DateTime @default(now())
  library     Library  @relation(fields: [libraryId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model TrialBooking {
  id           String              @id @default(cuid())
  libraryId    String
  slotTimingId String
  slotTypeId   String
  libraryName  String
  userId       String
  status       TrialBookingStatus?
  trialEndDate DateTime?
  createdAt    DateTime            @default(now())
  Attendance   Attendance[]
  library      Library             @relation(fields: [libraryId], references: [id])
  slotTiming   SlotTiming          @relation(fields: [slotTimingId], references: [id])
  slotType     SlotType            @relation(fields: [slotTypeId], references: [id])
  user         User                @relation(fields: [userId], references: [id])
}

model SlotType {
  id            String         @id @default(cuid())
  typeName      String
  duration      Int
  price         Float
  libraryId     String
  createdAt     DateTime       @default(now())
  bookings      Booking[]
  slotTimings   SlotTiming[]
  library       Library        @relation(fields: [libraryId], references: [id])
  trialBookings TrialBooking[]
}

model SlotTiming {
  id             String         @id @default(cuid())
  slotTypeId     String
  startTime      DateTime
  endTime        DateTime
  activeStudents Int            @default(0)
  createdAt      DateTime       @default(now())
  Attendance     Attendance[]
  bookings       Booking[]
  slotType       SlotType       @relation(fields: [slotTypeId], references: [id])
  trialBookings  TrialBooking[]
  payments  Payment[] 
}

model Booking {
  id           String         @id @default(cuid())
  libraryId    String
  slotTimingId String
  slotTypeId   String
  libraryName  String
  amount       Float
  userId       String
 paymentId    String?  @unique
  payment      Payment? @relation(fields: [paymentId], references: [id])

  createdAt    DateTime       @default(now())
  status       BookingStatus?
  endDate      DateTime?
  startDate    DateTime?
  Attendance   Attendance[]
  library      Library        @relation(fields: [libraryId], references: [id])
  slotTiming   SlotTiming     @relation(fields: [slotTimingId], references: [id])
  slotType     SlotType       @relation(fields: [slotTypeId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
}

model Attendance {
  id              String        @id @default(cuid())
  userId          String
  libraryId       String
  slotTimingId    String
  bookingId       String?
  trialBookingId  String?
  checkInTime     DateTime?
  checkOutTime    DateTime?
  durationMinutes Int?
  createdAt       DateTime      @default(now())
  Booking         Booking?      @relation(fields: [bookingId], references: [id])
  Library         Library       @relation(fields: [libraryId], references: [id])
  SlotTiming      SlotTiming    @relation(fields: [slotTimingId], references: [id])
  TrialBooking    TrialBooking? @relation(fields: [trialBookingId], references: [id])
  User            User          @relation(fields: [userId], references: [id])
  date            DateTime      @default(now())
}

enum Role {
  USER
  ADMIN
  DEVELOPER
}

enum BookingStatus {
  PENDING
  SUCCESS
  CANCELLED
}

enum TrialBookingStatus {
  ACTIVE
  EXPIRED
}



model Payment {
  id                String   @id @default(uuid())

  razorpayOrderId   String   @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?

  amount            Int
  currency          String   @default("INR")
  status            PaymentStatus @default(CREATED)

  userId            String
  user              User     @relation(fields: [userId], references: [id])

  slotTimingId      String
  slotTiming        SlotTiming @relation(fields: [slotTimingId], references: [id])

  booking           Booking?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
}


